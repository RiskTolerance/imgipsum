{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "placeholding",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-06",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// "vars": {
	//   "MY_VAR": "my-variable"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	"routes": [
		{ "pattern": "cdn.imgipsum.com", "custom_domain": true },
	],
	"r2_buckets": [
		{
			"binding": "CF_BUCKET",
			"bucket_name": "imgipsum",
		},
	],
	"images": {
		"binding": "CF_IMAGES",
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 60, "period": 60 },
			},
		],
	},
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}
